{
  "platform": "macos",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": false,
  "executable": {
    "type": "user_path",
    "default": "/Applications/electerm.app/Contents/MacOS/electerm",
    "required": false
  },
  "launch": {
    "type": "args",
    "template": "-l {username} -P {port} -pw {value} -t {name} -so {host}"
  },
  "display_name": "Electerm"
}
