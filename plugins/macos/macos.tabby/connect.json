{
  "platform": "macos",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": false,
  "executable": {
    "type": "user_path",
    "default": "/Applications/Tabby.app/Contents/MacOS/Tabby",
    "required": false
  },
  "launch": {
    "type": "args",
    "template": "profile {bridge_profile}"
  },
  "bridge": {
    "type": "local-profile",
    "profile_name": "JumpServer",
    "profile_id": "jumpserver-client",
    "script_name": "tabby-bridge.sh",
    "args_template": "{protocol} {username}@{host} -p {port} -P {value}",
    "config_path": "~/Library/Application Support/tabby/config.yaml",
    "shell": "/bin/sh",
    "run_fallback": true
  },
  "display_name": "Tabby"
}
