{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumpserver.org/schemas/client-plugin/connect.json",
  "title": "JumpServer Client Plugin Connect Definition",
  "type": "object",
  "required": ["platform", "executable", "launch"],
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["windows", "macos", "linux"]
    },
    "display_name": {
      "type": "string",
      "description": "Platform-specific display name override"
    },
    "match_first": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_set": {
      "type": "boolean",
      "default": false
    },
    "is_internal": {
      "type": "boolean",
      "default": false
    },
    "executable": { "$ref": "#/$defs/executable" },
    "launch": { "$ref": "#/$defs/launch" },
    "launch_by_category": {
      "type": "object",
      "propertyNames": {
        "enum": ["terminal", "remotedesktop", "filetransfer", "databases"]
      },
      "additionalProperties": { "$ref": "#/$defs/launch" },
      "description": "REQUIRED when manifest.category declares more than one category: every declared category must have its own launch definition here. The same app almost always needs different argv per role (e.g. an SFTP-only flag must not be passed when the plugin is used as an SSH terminal), so a category missing here is a packaging error: that category is not registered at all and an error is logged. It never falls back to launch. Single-category plugins ignore this field"
    },
    "bridge": { "$ref": "#/$defs/bridge" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Extra environment variables with template support"
    }
  },
  "$defs": {
    "executable": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["bundled", "system", "user_path"]
        },
        "default": {
          "type": "string",
          "description": "Default path or command name"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "If true, user must configure path before enabling (user_path)"
        }
      }
    },
    "launchArgs": {
      "type": "object",
      "required": ["type", "template"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "args" },
        "template": { "type": "string" },
        "split_mode": {
          "type": "string",
          "enum": ["space", "shell"],
          "default": "space",
          "description": "How to split template into argv after substitution"
        }
      }
    },
    "launchScript": {
      "type": "object",
      "required": ["type", "script"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "script" },
        "script": {
          "type": "string",
          "description": "Relative path to script inside plugin directory"
        },
        "interpreter": {
          "type": "string",
          "description": "Optional interpreter override, e.g. pwsh, bash"
        }
      }
    },
    "launchUrl": {
      "type": "object",
      "required": ["type", "template"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "url" },
        "template": { "type": "string" }
      }
    },
    "launchFile": {
      "type": "object",
      "required": ["type", "extension"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "file" },
        "extension": { "type": "string" },
        "open_with": {
          "type": "string",
          "enum": ["system", "executable"],
          "default": "system"
        },
        "arg_template": {
          "type": "string",
          "description": "Args when open_with is executable, {file} for temp path"
        }
      }
    },
    "launchAutoIt": {
      "type": "object",
      "required": ["type", "steps"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "autoit" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cmd"],
            "properties": {
              "cmd": { "type": "string" },
              "type": { "type": "string" },
              "element": { "type": "string" }
            }
          }
        }
      }
    },
    "launch": {
      "oneOf": [
        { "$ref": "#/$defs/launchArgs" },
        { "$ref": "#/$defs/launchScript" },
        { "$ref": "#/$defs/launchUrl" },
        { "$ref": "#/$defs/launchFile" },
        { "$ref": "#/$defs/launchAutoIt" }
      ]
    },
    "bridge": {
      "type": "object",
      "required": ["profile_name", "profile_id", "script_name", "args_template", "config_path"],
      "additionalProperties": false,
      "description": "Command bridge: the client writes a script that execs the bundled client with the credential, and installs one fixed local profile in the terminal's own config pointing at it, so the terminal opens that profile instead of asking the OS keychain for a password",
      "properties": {
        "type": { "const": "local-profile" },
        "profile_name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the fixed profile, matched by the terminal's `profile <name>` CLI"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "description": "Profile id written into the terminal config, used to detect an existing install"
        },
        "script_name": {
          "type": "string",
          "minLength": 1,
          "description": "Bridge script file name, stored under the client's own config directory"
        },
        "args_template": {
          "type": "string",
          "minLength": 1,
          "description": "Arguments for the bundled client only (program name is always the bundled client); same placeholders as launch.template"
        },
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the terminal's own config file, ~ allowed"
        },
        "shell": {
          "type": "string",
          "default": "/bin/sh",
          "description": "Interpreter for the bridge script"
        },
        "run_fallback": {
          "type": "boolean",
          "default": false,
          "description": "Fall back to `<terminal> run <script>` when the terminal has not loaded the profile yet (shows a one-off confirmation dialog)"
        }
      }
    }
  }
}
